 lib/aurora.cpp               | 118 ++++++++++++++++++++++++++++++++++-
 lib/dolphin/gx/GXTexture.cpp |  35 +++++++++++
 lib/gfx/pipeline_cache.cpp   |  10 +++
 4 files changed, 164 insertions(+), 1 deletion(-)

